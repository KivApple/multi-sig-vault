{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": false,
		"noEmit": true,
		"paths": { "@/*": ["./src/*"] },
		"types": ["node", "w3c-web-usb", "w3c-web-hid"]
	},
	"include": ["src", "tests", "rsbuild.config.ts", "scripts"]
}
